# intranet_bundle 环境变量(放 bundle 根, 自动加载, 不进库)
# 复制本文件为 .env, 填真实值。env 优先级 > .env > config.yaml

# 内网 LLM token(JWT)。mode: intranet 时必填; mode: openai 时作为 api_key
LLM_TOKEN=eyJ0eXAiOiJKV1Q...填你的真实token

# (可选)LLM 模式: mock / openai / intranet(也可在 config.yaml 设)
# LLM_MODE=intranet

# (可选)agent adapter(跑批用)
# AGENT_BASE_URL=http://localhost:18091
# AGENT_NAME=zdt_agent
